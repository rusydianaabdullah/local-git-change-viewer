# Base folder the viewer may read (mounted read-write so fetch/pull work). Added folders must be inside it.
ALLOW_ROOT=/home/youruser/code
# Folder shown by default on first load (must be inside ALLOW_ROOT).
PROJECTS_DIR=/home/youruser/code/projects
# Host port.
PORT=8005
# Host user/group id that owns the repos (run `id -u` / `id -g`).
UID=1000
GID=1000
CONTAINER_NAME=git-change-viewer
